// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String
  avatar              String?
  password            String
  role                UserRole  @default(USER)
  isActive            Boolean   @default(true)
  isVerified          Boolean   @default(false)
  isEmailVerified     Boolean   @default(false)
  emailVerificationToken String?
  registrationIP      String?
  isStreamer          Boolean   @default(false)
  lastLoginAt         DateTime?
  lastLoginIP         String?
  tokenVersion        Int       @default(0)
  failedLoginAttempts Int       @default(0)
  isLocked            Boolean   @default(false)
  lockedUntil         DateTime?
  resetToken          String?
  resetTokenExpires   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Core Relations
  profiles                UserProfile[]
  subscriptions           Subscription[]
  watchHistory            WatchHistory[]
  favorites               Favorite[]
  reviews                 Review[]
  payments                Payment[]
  notifications           Notification[]
  notificationPreferences NotificationPreferences?

  // Extended Features Relations
  blogPosts             BlogPost[]
  blogComments          BlogComment[]
  blogAuthoredComments  BlogComment[]     @relation("CommentAuthor")
  donations             Donation[]        @relation("DonorDonations")
  streamerEarns         Donation[]        @relation("StreamerDonations")
  sentGifts             GiftTransaction[] @relation("SentGifts")
  receivedGifts         GiftTransaction[] @relation("ReceivedGifts")
  streamerSessions      PrivateSession[]  @relation("StreamerSessions")
  viewerSessions        PrivateSession[]  @relation("ViewerSessions")
  shortVideos           ShortVideo[]
  liveStreams           LiveStream[]
  streamViews           StreamViewer[]
  chatMessages          ChatMessage[]
  twoFactorAuth         TwoFactorAuth?
  userStats             UserStats?
  achievements          UserAchievement[]
  rewards               UserReward[]
  loginAttempts         LoginAttempt[]
  followers             Follow[]          @relation("Followers")
  following             Follow[]          @relation("Following")
  scheduledStreams      ScheduledStream[]
  tenantId              String?
  sessions              UserSession[]
  comments              Comment[]
  likes                 Like[]
  watchlist             Watchlist[]
  ratings               Rating[]
  followersCount        Int               @default(0)
  allowsPrivateSessions Boolean           @default(false)
  createdContent        Content[]         @relation("ContentCreator")
  wallet                UserWallet?
  userPoints            UserPoints?
  streamerEarnings      StreamerEarnings?
  streamerPayouts       StreamerPayout[]
  purchases             Purchase[]
  pointTransactions     PointsTransaction[]
  xpTransactions        XpTransaction[]
  walletTransactions    WalletTransaction[]
  shortInteractions     ShortVideoInteraction[]
  shortComments         ShortVideoComment[]
  streamReminders       StreamReminder[]
  pushTokens            PushToken[]
  recoveryCodes         TwoFactorRecovery[]
  userInteractions      UserInteraction[]
  comingSoonStreams     ComingSoonStream[]

  @@map("users")
}

model UserProfile {
  id             String   @id @default(cuid())
  name           String
  avatar         String?
  isKidsProfile  Boolean  @default(false)
  language       String   @default("en")
  maturityRating String   @default("PG-13")
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchHistory WatchHistory[]

  @@map("user_profiles")
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  planType             SubscriptionType
  status               SubscriptionStatus
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  stripeSubscriptionId String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Content {
  id             String      @id @default(cuid())
  title          String
  description    String
  thumbnail      String
  backdrop       String?
  trailer        String?
  videoUrl       String
  duration       Int // in seconds
  releaseDate    DateTime
  rating         Float       @default(0)
  maturityRating String
  language       String      @default("en")
  type           ContentType
  season         Int?
  episode        Int?
  seriesId       String?
  isExclusive    Boolean     @default(false)
  isPremium      Boolean     @default(false)
  isPublished    Boolean     @default(false)
  isFeatured     Boolean     @default(false)
  isTrending     Boolean     @default(false)
  viewCount      Int         @default(0)
  creatorId      String?
  isApproved     Boolean     @default(true)
  tenantId       String?
  genre          String?
  director       String?
  moderationStatus String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relations
  creator       User?          @relation("ContentCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  series        Content?       @relation("SeriesEpisodes", fields: [seriesId], references: [id])
  episodes      Content[]      @relation("SeriesEpisodes")
  genres        ContentGenre[]
  cast          ContentCast[]
  crew          ContentCrew[]
  subtitles     Subtitle[]
  audioTracks   AudioTrack[]
  qualityLevels QualityLevel[]
  watchHistory  WatchHistory[]
  favorites     Favorite[]
  reviews       Review[]
  adBreaks      AdBreak[]
  moderationResults ModerationResult[]
  comments      Comment[]
  likes         Like[]
  watchlist     Watchlist[]
  ratings       Rating[]

  @@index([isPublished, type])
  @@index([rating])
  @@map("content")
}

model Genre {
  id      String         @id @default(cuid())
  name    String         @unique
  slug    String         @unique
  content ContentGenre[]

  @@map("genres")
}

model ContentGenre {
  contentId String
  genreId   String

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  genre   Genre   @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([contentId, genreId])
  @@map("content_genres")
}

model Person {
  id     String        @id @default(cuid())
  name   String
  avatar String?
  bio    String?
  cast   ContentCast[]
  crew   ContentCrew[]

  @@map("people")
}

model ContentCast {
  id        String @id @default(cuid())
  contentId String
  personId  String
  character String
  order     Int    @default(0)

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@map("content_cast")
}

model ContentCrew {
  id        String @id @default(cuid())
  contentId String
  personId  String
  role      String // director, producer, writer, etc.

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@map("content_crew")
}

model Subtitle {
  id        String  @id @default(cuid())
  contentId String
  language  String
  label     String
  url       String
  isDefault Boolean @default(false)

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("subtitles")
}

model AudioTrack {
  id        String  @id @default(cuid())
  contentId String
  language  String
  label     String
  url       String
  isDefault Boolean @default(false)

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("audio_tracks")
}

model QualityLevel {
  id         String @id @default(cuid())
  contentId  String
  quality    String // 4K, 1080p, 720p, etc.
  resolution String // 3840x2160, 1920x1080, etc.
  bitrate    Int // in kbps
  url        String

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("quality_levels")
}

model WatchHistory {
  id        String   @id @default(cuid())
  userId    String
  profileId String?
  contentId String
  progress  Float    @default(0) // percentage watched
  watchDuration Int    @default(0)
  completed Boolean  @default(false)
  watchedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile UserProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  content Content      @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@map("watch_history")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@map("favorites")
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  rating    Int // 1-10
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@map("reviews")
}

model Advertisement {
  id          String    @id @default(cuid())
  title       String
  description String?
  videoUrl    String
  clickUrl    String?
  duration    Int // in seconds
  skipAfter   Int? // seconds after which skip is allowed
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  adBreaks    AdBreak[]

  @@map("advertisements")
}

model AdBreak {
  id              String @id @default(cuid())
  contentId       String
  advertisementId String
  position        Int // seconds into the video
  order           Int @default(0)

  content       Content       @relation(fields: [contentId], references: [id], onDelete: Cascade)
  advertisement Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)

  @@map("ad_breaks")
}

model Payment {
  id               String            @id @default(cuid())
  userId           String
  amount           Float
  currency         String            @default("USD")
  status           PaymentStatus
  paymentMethod    String // stripe, sslcommerz, paypal
  paymentIntentId  String?
  subscriptionType SubscriptionType?
  type             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  title       String
  message     String
  type        NotificationType
  channels    String[]         @default([])
  priority    String           @default("medium")
  data        Json?
  isRead      Boolean          @default(false)
  scheduledAt DateTime?
  expiresAt   DateTime?
  sentAt      DateTime?
  status      String           @default("pending")
  createdAt   DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ==========================================
// Extended Models Supporting Backend Services
// ==========================================

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String
  summary     String?
  thumbnail   String?
  authorId    String
  categoryId  String?
  status      String    @default("draft") // draft, published, archived
  views       Int       @default(0)
  likes       Int       @default(0)
  publishedAt   DateTime?
  authorType    String?
  isSticky      Boolean   @default(false)
  allowComments Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  comments BlogComment[]

  @@map("blog_posts")
}

model BlogComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  parentId  String?
  authorId  String?
  status    String   @default("approved")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post    BlogPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  author  User?         @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  parent  BlogComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies BlogComment[] @relation("CommentReplies")

  @@map("blog_comments")
}

model BlogCategory {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  color       String?
  postCount   Int        @default(0)
  isActive    Boolean    @default(true)
  posts       BlogPost[]

  @@map("blog_categories")
}

model Donation {
  id            String    @id @default(cuid())
  donorId       String
  streamerId    String
  streamId      String?
  amount        Float
  currency      String    @default("USD")
  message       String?
  isAnonymous   Boolean   @default(false)
  giftId        String?
  status        String    @default("pending") // pending, completed, failed, refunded
  paymentMethod String    @default("card")
  transactionId String?
  createdAt     DateTime  @default(now())
  processedAt   DateTime?

  donor    User @relation("DonorDonations", fields: [donorId], references: [id], onDelete: Cascade)
  streamer User @relation("StreamerDonations", fields: [streamerId], references: [id], onDelete: Cascade)

  @@map("donations")
}

model VirtualGift {
  id            String   @id @default(cuid())
  name          String
  description   String?
  imageUrl      String
  price         Float
  currency      String   @default("USD")
  category      String   @default("hearts")
  rarity        String   @default("common")
  streamerShare Float    @default(70)
  platformFee   Float    @default(30)
  isActive       Boolean   @default(true)
  isLimited      Boolean   @default(false)
  availableUntil DateTime?
  createdAt      DateTime  @default(now())

  @@map("virtual_gifts")
}

model GiftTransaction {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  streamId    String?
  giftId      String
  quantity    Int      @default(1)
  totalAmount Float
  message     String?
  isAnonymous Boolean  @default(false)
  status      String   @default("sent")
  createdAt   DateTime @default(now())

  sender   User @relation("SentGifts", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedGifts", fields: [receiverId], references: [id], onDelete: Cascade)

  @@map("gift_transactions")
}

model PrivateSession {
  id             String    @id @default(cuid())
  streamerId     String
  viewerId       String
  title          String
  description    String?
  pricePerMinute Float
  currency       String    @default("USD")
  status         String    @default("scheduled")
  scheduledAt    DateTime?
  startedAt      DateTime?
  endedAt        DateTime?
  duration       Int? // minutes
  totalCost      Float     @default(0)
  paymentStatus  String    @default("pending")
  streamUrl      String?
  createdAt      DateTime  @default(now())

  streamer User @relation("StreamerSessions", fields: [streamerId], references: [id], onDelete: Cascade)
  viewer   User @relation("ViewerSessions", fields: [viewerId], references: [id], onDelete: Cascade)

  @@map("private_sessions")
}

model ShortVideo {
  id           String   @id @default(cuid())
  title        String
  description  String?
  videoUrl     String
  thumbnailUrl String
  duration     Int      @default(15) // seconds
  creatorId    String
  category     String   @default("entertainment")
  tags         String[] @default([])
  views        Int      @default(0)
  likes        Int      @default(0)
  commentsCount Int     @default(0)
  shares       Int      @default(0)
  isPublished  Boolean  @default(true)
  isApproved   Boolean  @default(true)
  isTrending   Boolean  @default(false)
  publishedAt  DateTime?
  uploadedAt   DateTime @default(now())
  metadata     Json?

  creator       User                    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  interactions  ShortVideoInteraction[]
  comments      ShortVideoComment[]

  @@map("short_videos")
}

model StoreItem {
  id             String    @id @default(cuid())
  name           String
  description    String?
  price          Float
  currency       String    @default("USD")
  type           String    @default("avatar") // avatar, theme, emote, badge
  imageUrl       String
  category       String?
  stock          Int?
  originalPrice  Float?
  isActive       Boolean   @default(true)
  isLimited      Boolean   @default(false)
  availableUntil DateTime?
  discount       Float     @default(0)
  tags           String[]  @default([])
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  purchases      Purchase[]

  @@map("store_items")
}

model LiveStream {
  id                 String    @id @default(cuid())
  streamerId         String
  title              String
  description        String?
  streamKey          String    @unique
  playbackUrl        String?
  rtmpUrl            String?
  hlsUrl             String?
  status             String    @default("idle") // idle, live, ended
  viewerCount        Int       @default(0)
  peakViewerCount    Int       @default(0)
  currentViewerCount Int       @default(0)
  finalViewerCount   Int       @default(0)
  startTime          DateTime?
  endTime            DateTime?
  startedAt          DateTime?
  endedAt            DateTime?
  chatEnabled        Boolean   @default(true)
  recordingEnabled   Boolean   @default(false)
  maxViewers         Int?
  category           String?
  tags               String[]  @default([])
  tenantId           String?
  createdAt          DateTime  @default(now())

  tenant       Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  streamer     User           @relation(fields: [streamerId], references: [id], onDelete: Cascade)
  viewers      StreamViewer[]
  chatMessages ChatMessage[]
  sessions     StreamSession[]

  @@map("live_streams")
}

model StreamViewer {
  id        String    @id @default(cuid())
  streamId  String
  userId    String
  userAgent String?
  ipAddress String?
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  stream LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("stream_viewers")
}

model ChatMessage {
  id        String   @id @default(cuid())
  streamId  String
  userId    String
  username  String?
  message   String
  type      String   @default("message")
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  stream LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model TwoFactorAuth {
  id          String   @id @default(cuid())
  userId      String   @unique
  secret      String
  backupCodes String[] @default([])
  isEnabled   Boolean   @default(false)
  enabledAt   DateTime?
  disabledAt  DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_auth")
}

model UserStats {
  id               String   @id @default(cuid())
  userId           String   @unique
  totalXP          Int      @default(0)
  currentLevel     Int      @default(1)
  watchTimeMinutes Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement? @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model UserReward {
  id         String   @id @default(cuid())
  userId     String
  rewardId   String
  rewardType String
  source     String?
  avatarId   String?
  claimedAt  DateTime @default(now())

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatar UserAvatar? @relation(fields: [avatarId], references: [id], onDelete: SetNull)

  @@map("user_rewards")
}

model NotificationPreferences {
  id            String   @id @default(cuid())
  userId        String   @unique
  streamLive    Json?
  newFollower   Json?
  donations     Json?
  comments      Json?
  systemUpdates Json?
  promotions    Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  ip        String
  userAgent String?
  success   Boolean
  timestamp DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("login_attempts")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

model ScheduledStream {
  id                String   @id @default(cuid())
  streamerId        String
  title             String
  description       String?
  category          String   @default("gaming")
  tags              String[] @default([])
  scheduledAt       DateTime
  estimatedDuration Int      @default(60)
  status            String   @default("scheduled")
  isRecurring       Boolean  @default(false)
  notificationSent  Boolean  @default(false)
  remindersSent     Boolean  @default(false)
  actualStartTime   DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt @default(now())

  streamer           User             @relation(fields: [streamerId], references: [id], onDelete: Cascade)
  reminders          StreamReminder[]
  scheduledReminders StreamReminder[] @relation("ScheduledReminders")

  @@map("scheduled_streams")
}

// Enums
enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum SubscriptionType {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  PAST_DUE
}

enum ContentType {
  MOVIE
  SERIES
  DOCUMENTARY
  LIVE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum NotificationType {
  SYSTEM
  CONTENT
  PAYMENT
  SUBSCRIPTION
}

model StreamBan {
  id        String    @id @default(cuid())
  userId    String
  streamId  String
  reason    String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@map("stream_bans")
}

model StreamModerator {
  id        String   @id @default(cuid())
  userId    String
  streamId  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("stream_moderators")
}

model StreamTimeout {
  id        String   @id @default(cuid())
  userId    String
  streamId  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("stream_timeouts")
}

model RateLimit {
  key        String   @id
  lastAction DateTime @default(now())

  @@map("rate_limits")
}

model Tenant {
  id          String   @id @default(cuid())
  name        String
  domain      String   @unique
  subdomain   String   @unique
  status      String   @default("active")
  plan        String   @default("starter")
  features    Json?
  branding    Json?
  limits      Json?
  billing     Json?
  settings    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       TenantUser[]
  content     Content[]
  liveStreams LiveStream[]

  @@map("tenants")
}

model TenantUser {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String?
  email       String
  role        String   @default("member")
  permissions Json?
